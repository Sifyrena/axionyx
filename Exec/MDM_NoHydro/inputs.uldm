# FWPHYS GOETTINGEN RUN SERIES SEVEN (NIP084-PAPER1-B) 
# ------------------  VARIABLE INPUTS    ------------------------
# M10 F10
# FDM RATIO IS 0.0843

nyx.m_tt = 0.010
nyx.ratio_fdm = 0.0843 

cosmo.initDirName = Init_1024/z120_m10_f10/C/
cosmo.FDMinitDirName = Init_1024/z120_m10_f10/A/

# Output PATH (Must Manually Create the Folders ...)

amr.check_file = Runs/1024/z120_f10_60/chk
amr.plot_file = Runs/1024/z120_f10_60/plt
amr.data_log = Runs/1024/z120_f10_60/runlog.uldm

# ------------------ INPUTS TO MAIN PROGRAM  -------------------
max_step = 999999

nyx.comoving_OmB = 0.0
nyx.comoving_OmM = 0.31
nyx.comoving_h = 0.675

nyx.h_species  = 0.76
nyx.he_species = 0.24

nyx.inhomo_reion = 0

nyx.strang_split     = 1
nyx.strang_grown_box = 0
nyx.add_ext_src      = 0
nyx.heat_cool_type   = 0

nyx.small_dens = 1e-4

nyx.initial_z = 120
nyx.final_z = 2.0

nyx.do_santa_barbara = 0
gravity.sl_tol = 1.e-12

# nyx.initial_dt = 1.e-6
nyx.vonNeumann_dt = 1.0

gravity.no_sync      = 1 # OK BECAUSE NO REFINEMENT
gravity.no_composite = 1 # OK BECAUSE NO REFINEMENT

gravity.ml_tol    = 1.e-10
gravity.sl_tol    = 1.e-10
gravity.delta_tol = 1.e-10

mg.bottom_solver = 1

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  1 1 1
geometry.coord_sys   =  0

geometry.prob_lo     = 0 0 0
geometry.prob_hi = 88.888889 88.888889 88.888889 # 60 Mpc/h

amr.n_cell = 1024 1024 1024
amr.max_grid_size    = 64
amr.blocking_factor  = 64

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
nyx.lo_bc       =  0	  0	    0
nyx.hi_bc       =  0	  0	    0

# >>>>>>>>> FDM PHYSICS <<<<<<<<<<<
nyx.levelmethod = 3 # PSEUDOSPECTRAL

# WHICH PHYSICS
nyx.do_hydro = 0
nyx.gamma = 1.666
nyx.do_grav  = 1

# PARTICLES
nyx.do_dm_particles = 1
mg.show_timings = 1
fabarray.mfiter_tile_size = 1024000 8 8
nyx.particle_init_type = Cosmological
nyx.n_particles = 1024 1024 1024
cosmo.ic-source = MUSIC
cosmo.mixed_cosmology = 1
nyx.particle_move_type = Gravitational

# TIME STEP CONTROL
nyx.cfl            = 0.1     # cfl number for hyperbolic system
nyx.init_shrink    = 0.02     # scale back initial timestep
nyx.change_max     = 1.05    # scale back initial timestep
nyx.dt_cutoff      = 1.e-25  # level 0 timestep below which we halt

# DIAGNOSTICS & VERBOSITY
nyx.sum_interval   = 0     # timesteps between computing mass
nyx.v              = 0       # verbosity in Castro.cpp
gravity.v             = 0       # verbosity in Gravity.cpp
amr.v                 = 0       # verbosity in Amr.cpp
mg.v                  = 0       # verbosity in Amr.cpp
particles.v           = 0       # verbosity in Particle class

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

amr.regrid_on_restart  = 0
amr.subcycling_mode    = Manual
amr.subcycling_iterations = 2
amr.grid_eff           = 0.7

# CHECKPOINT FILES

amr.check_int       = 10000
#amr.check_per	    = 1.e-6

# PLOTFILES
amr.plot_int        = 2000
nyx.plot_z_values   = 120.0 100.0 90.0 60.0 30.0 20.0 10.0 7.0 6.0 5.0 4.0 3.0 2.0
amr.plot_vars = AxDens AxPhas
amr.derive_plot_vars = particle_mass_density particle_x_velocity particle_y_velocity particle_z_velocity

#PROBIN FILENAME
amr.probin_file = ""

nyx.use_typical_steps = 1
nyx.sundials_abstol = 1.0e-4
nyx.sundials_reltol = 1.0e-4
nyx.sundials_tile_size = 256 128 128
nyx.hydro_tile_size = 256 128 128